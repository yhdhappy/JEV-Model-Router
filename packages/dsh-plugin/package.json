{
  "name": "dsh-plugin-jev-router",
  "version": "0.0.1",
  "private": true,
  "description": "JEV Model Router adapter for DeepSeek Harness — P0 observation-only probe that classifies a task through the real JEV (TypeSafe System One) API",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
